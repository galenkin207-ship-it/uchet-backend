PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uchet_db
DB_USER=uchet_app
DB_PASSWORD=change_me
SESSION_SECRET=change_me_to_a_long_random_string
# Через запятую, без пробелов. Не обязательно если фронтенд и бэкенд
# на одном домене за одним nginx (тогда CORS не нужен вообще).
CORS_ORIGIN=https://uchet.kostya.online

# S3-совместимое хранилище (Beget Object Storage) для фото записей
# (record_photos). Рантайм хранит и отдаёт фото только через S3 — все шесть
# переменных ниже обязательны для работы загрузки/просмотра/удаления фото.
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_REGION=ru1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# С завершающим слэшем — например "prod/" или "staging/". Позволяет держать
# прод и staging в одном бакете без пересечения ключей.
S3_PREFIX=prod/
# Срок жизни presigned-ссылки на фото (GET /:id/photos/:filename делает
# 302-редирект на такую ссылку).
S3_PRESIGN_EXPIRY_SECONDS=900

# PHOTOS_DIR/PHOTOS_TRASH_DIR нужны только для одноразового запуска
# scripts/migrate-photos-to-s3.js (перенос старых локальных файлов в S3) —
# рантайм (src/routes/records.js) их больше не использует.
PHOTOS_DIR=/opt/uchet/uploads/photos
PHOTOS_TRASH_DIR=/opt/uchet/uploads/photos-trash

# Web Push (браузерные push-уведомления). Сгенерировать пару:
# npx web-push generate-vapid-keys --json
# Без этих переменных push-уведомления просто отключены (остальное приложение работает как обычно).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Восстановление пароля по email. Без этих переменных форма "забыли пароль"
# продолжает работать (не выдаёт ошибку), но письма никуда не уходят —
# восстановление в этом случае доступно только вручную на сервере через
# scripts/reset-password.js. Пример для личной почты на Яндексе: заведите
# пароль приложения (Яндекс ID -> Пароли и переадресация -> Пароли приложений),
# обычный пароль от аккаунта тут не подойдёт при включённой двухфакторке.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=you@yandex.ru
SMTP_PASS=пароль_приложения
SMTP_FROM=you@yandex.ru
# Базовый URL фронтенда — используется для ссылки в письме восстановления
APP_URL=https://uchet.kostya.online
